# Test-only mod for SESSION D (battle-end host authority + wantsToSurrender
# disposition). surrenderMode: 2 activates the mod-gated reader
# BattlescapeGame::isSurrendering (surrenderMode>=2 reads wantsToSurrender), which
# feeds tally.liveAliens -> the battle-complete decision. wantsToSurrender is set
# on the panic path (BattleUnit::prepareNewTurn) which the PARALLEL client DEFERS,
# so a panicked surrendering alien is host=surrendering / client=still-fighting.
# canSurrender: true on the Sectoid types makes them eligible so the reader is
# reachable in a stock NEW BATTLE > COOP skirmish (default race STR_SECTOID). With
# battle end host-authoritative (NextTurnState gate) the client never ends on this
# divergent local tally - it follows the host's "DebriefingState" packet.
surrenderMode: 2
units:
  - type: STR_SECTOID_SOLDIER
    canSurrender: true
  - type: STR_SECTOID_NAVIGATOR
    canSurrender: true
  - type: STR_SECTOID_MEDIC
    canSurrender: true
  - type: STR_SECTOID_ENGINEER
    canSurrender: true
  - type: STR_SECTOID_LEADER
    canSurrender: true
  - type: STR_SECTOID_COMMANDER
    canSurrender: true
