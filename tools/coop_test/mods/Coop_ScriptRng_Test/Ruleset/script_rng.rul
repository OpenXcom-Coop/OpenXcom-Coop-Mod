# Test-only mod for PRD-P3 GAP-10 (script RNG). The newTurnUnit hook fires on
# EVERY unit at every side close, on BOTH machines in a parallel co-op battle
# (SavedBattleGame::newTurnUpdateScripts, reached via BattlescapeGame::endTurn ->
# _save->endTurn). It draws both script-RNG bindings from the global RNG stream
# and stores the results in per-unit scriptTags:
#   COOP_RNG_R  <- battle_game.randomRange  (randomRangeScript)
#   COOP_RNG_C  <- battle_game.randomChance (randomChanceScript)
# next_turn does NOT re-ship scriptTags, so any divergence in the drawn values
# persists and shows up in the save_blob dump - the direct probe the test reads.
# All var declarations must precede the first operation (OXCE y-script rule).
extended:
  tags:
    BattleUnit:
      COOP_RNG_R: int
      COOP_RNG_C: int
  scripts:
    newTurnUnit:
      - offset: 1
        code: |
          var int r;
          var int c;
          battle_game.randomRange r 0 1000000;
          unit.setTag Tag.COOP_RNG_R r;
          set c 50;
          battle_game.randomChance c;
          unit.setTag Tag.COOP_RNG_C c;
          return;
