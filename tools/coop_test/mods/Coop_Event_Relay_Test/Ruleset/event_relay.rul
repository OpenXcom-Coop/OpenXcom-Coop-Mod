# W2-H75 (R-B109-1) test fixture (spec rewrite/prompts/w2h75_event_relay_once.md (e) M2). No language file (raw keys).
# Each cutscene has no videos and no slideshow: a play logs "cutscene definition empty: <id>"; STR_H75_WIN ends the game.
cutscenes:
  - type: STR_H75_A
  - type: STR_H75_C
  - type: STR_H75_M
  - type: STR_H75_WIN
    winGame: true
events:
  - name: STR_H75_EV_A
    description: STR_H75_EV_A
    cutscene: STR_H75_A
  - name: STR_H75_EV_C
    description: STR_H75_EV_C
    cutscene: STR_H75_C
    timer: 20160
  - name: STR_H75_EV_M
    description: STR_H75_EV_M
    cutscene: STR_H75_M
  - name: STR_H75_EV_WIN
    description: STR_H75_EV_WIN
    cutscene: STR_H75_WIN
research:
  - name: STR_H75_T_A
    cost: 1
    points: 5
    spawnedEvent: STR_H75_EV_A
  - name: STR_H75_T_M
    cost: 10
    points: 1
    spawnedEvent: STR_H75_EV_M
  - name: STR_H75_T_WIN
    cost: 1
    points: 5
    spawnedEvent: STR_H75_EV_WIN
eventScripts:
  - type: STR_H75_SCRIPT_C
    oneTimeSequentialEvents:
      - STR_H75_EV_C
    firstMonth: 0
    lastMonth: 0
    executionOdds: 100
alienDeployments:
  - type: STR_TERROR_MISSION
    unlockedResearchOnDespawn: STR_H75_T_M
